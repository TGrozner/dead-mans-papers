{
  "name": "dead-mans-papers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=23.8.0 <24"
  },
  "scripts": {
    "check:node": "node scripts/with-node.mjs node scripts/check-node.mjs",
    "check:types": "npm run check:node && node scripts/with-node.mjs tsc",
    "dev": "node scripts/with-node.mjs vite",
    "e2e": "FORCE_COLOR=0 node scripts/with-node.mjs playwright test",
    "validate:content": "node scripts/with-node.mjs node scripts/validate-content.mjs",
    "test": "npm run validate:content && npm run check:types && npm run e2e",
    "build": "npm run check:types && node scripts/with-node.mjs vite build",
    "build:e2e": "node scripts/with-node.mjs vite build --outDir dist-e2e",
    "build:pages:e2e": "GITHUB_PAGES=true node scripts/with-node.mjs vite build --outDir dist-pages",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "preview": "node scripts/with-node.mjs vite preview",
    "preview:pages": "node scripts/with-node.mjs vite preview --base /dead-mans-papers/"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
