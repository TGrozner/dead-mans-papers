{
  "name": "dead-mans-papers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=23.8.0 <24"
  },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "dev": "npm run check:node && vite",
    "e2e": "npm run check:node && playwright test",
    "validate:content": "npm run check:node && node scripts/validate-content.mjs",
    "test": "npm run validate:content && npm run build && npm run e2e",
    "build": "npm run check:node && tsc && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "preview": "npm run check:node && vite preview",
    "preview:pages": "npm run check:node && vite preview --base /dead-mans-papers/"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
